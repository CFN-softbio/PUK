&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   outdir           = './out'
   prefix           = 'Li_bcc'
   disk_io          = 'none'
   pseudo_dir       = '/home2/smathur/puks-codex-fresh/lattice-li/pseudopotentials'
/
&SYSTEM
   ibrav            = 0
   nat              = 2
   ntyp             = 1
    ecutwfc = 120,
    ecutrho = 480,
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'marzari-vanderbilt'
   input_dft        = 'PBE'
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Li 6.94 li_pbe_v1.4.uspp.F.UPF

K_POINTS automatic
13 13 13 0 0 0

CELL_PARAMETERS angstrom
3.45100000000000 0.00000000000000 0.00000000000000
0.00000000000000 3.45100000000000 0.00000000000000
0.00000000000000 0.00000000000000 3.45100000000000

ATOMIC_POSITIONS angstrom
Li 0.0000000000 0.0000000000 0.0000000000  
Li 1.7255000000 1.7255000000 1.7255000000  

