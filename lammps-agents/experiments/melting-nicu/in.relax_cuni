# ============================================================
# Step 1: Build & relax FCC Ni-Cu (50-50) alloy crystal
#   - box/relax + minimize to find equilibrium lattice
#   - NPT thermal equilibration at 300 K
# Types: 1 = Ni, 2 = Cu   (funcfl EAM auto-mixed by LAMMPS)
# ============================================================
units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       cuni_fcc.lmp

pair_style      eam
pair_coeff      1 1 Ni_u3.eam
pair_coeff      2 2 Cu_u3.eam

# --- Relax box (anisotropic) + atomic positions ---
fix             1 all box/relax aniso 0.0 vmax 0.001
min_style       cg
minimize        1.0e-10 1.0e-10 10000 100000
unfix           1

# --- Thermal equilibration at 300 K (NPT, zero pressure) ---
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
timestep        0.001
thermo          100
thermo_style    custom step temp pe ke etotal press vol lx ly lz
fix             2 all npt temp 300.0 300.0 0.1 aniso 0.0 0.0 1.0
run             15000
unfix           2

write_data      relaxed.data
print           "STEP1 DONE: relaxed FCC Ni-Cu written to relaxed.data"
