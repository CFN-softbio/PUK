dump 1 all custom ${dump_time} ${dump_out_name}.* id type x y z c_peratom
dump 1 all custom 1000 ${dump_out_name}.* id type x y z c_peratom
dump 1 all custom 1000 ./dump_lattice_constant/dump.out.* id type x y z c_peratom

variable p1 equal "step"
variable p2 equal "count(all)"
variable p3 equal "lx"
variable p4 equal "ly"
variable p5 equal "lz"
variable p6 equal "pe"
variable p7 equal "vol"

fix 1 all box/relax aniso 0
min_style cg
minimize 0 1e-5 2000 20000
