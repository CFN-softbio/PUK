LAMMPS (22 Jul 2025 - Update 3)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
units metal
dimension 3
boundary p s p

shell cd ./W_screw_Zhou04

variable data_file string "data.unrelaxed.dislocated.initial.lmp"
variable potential_file string "potential.inp"
variable thermo_time equal 100
variable dump_time equal 1000

read_data ${data_file}
read_data data.unrelaxed.dislocated.initial.lmp
Reading data file ...
  triclinic box = (0 -0.0029100175 0) to (38.763175 29.096819 5.4819408) with tilt (0 0 0)
  2 by 2 by 1 MPI processor grid
  reading atoms ...
  420 atoms
  reading velocities ...
  420 velocities
  read_data CPU = 0.004 seconds
include ${potential_file}
include potential.inp
pair_style eam/alloy
pair_coeff * * ../potential_repository/W_Zhou04.eam.alloy W
Reading eam/alloy potential file ../potential_repository/W_Zhou04.eam.alloy with DATE: 2018-03-30

compute peratom all pe/atom
compute pe all pe

thermo_style custom step temp pe vol press pxx pyy pzz fnorm
thermo_modify format float %5.5g
thermo ${thermo_time}
thermo 100

shell mkdir relax_screw_dislocation

variable dump_id equal 1
variable N equal 100
variable dump_out_name string "./relax_screw_dislocation/dump.out"
dump ${dump_id} all custom ${dump_time} ${dump_out_name}.* id type x y z c_peratom
dump 1 all custom ${dump_time} ${dump_out_name}.* id type x y z c_peratom
dump 1 all custom 1000 ${dump_out_name}.* id type x y z c_peratom
dump 1 all custom 1000 ./relax_screw_dislocation/dump.out.* id type x y z c_peratom

variable p1 equal "step"
variable p2 equal "lx"
variable p3 equal "ly"
variable p4 equal "lz"
variable p5 equal "pe"
variable p6 equal "vol"

fix extra all print 100 "${p1} ${p2} ${p3} ${p4} ${p5} ${p6}" file "dislocation.csv" title "#step a_x a_y a_z pe vol" screen no


variable iii loop 5
variable tol equal 0.1

reset_timestep 0
label min

fix min1 all box/relax x 0.0 z 0.0 xz 0.0 vmax 0.001
min_style cg
minimize 0 1e-4 2000 2000
